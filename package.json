{
  "name": "procurement-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check:static": "eslint . && tsc --noEmit",
    "lab:up": "docker compose up --wait --wait-timeout 60 db && npm run lab:init",
    "lab:doctor": "node --test tests/smoke/health.test.mjs",
    "test:e2e": "playwright test",
    "lab:down": "docker compose down",
    "lab:init": "node --env-file-if-exists=.env scripts/init-lab.mjs",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/procurement.test.mjs",
    "verify:concurrency": "node --env-file-if-exists=.env scripts/verify-concurrency.mjs",
    "verify:ph42-fixture": "node --env-file-if-exists=.env scripts/verify-ph42-fixture.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
