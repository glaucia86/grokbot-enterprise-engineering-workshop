{
  "name": "procurement-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "check:static": "bun --bun eslint . && bun --bun tsc --noEmit",
    "lab:up": "docker compose up --wait --wait-timeout 60 db && bun run lab:init",
    "lab:doctor": "bun scripts/lab-doctor.ts",
    "test:e2e": "bun --bun playwright test",
    "lab:down": "docker compose down",
    "lab:init": "bun scripts/init-lab.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration/procurement.test.ts",
    "test:migration": "bun test tests/integration/idempotency-migration.test.ts",
    "verify:concurrency": "bun scripts/verify-concurrency.ts",
    "verify:ph42-fixture": "bun scripts/verify-ph42-fixture.ts",
    "verify:all": "bun engineering/verify-lab.ts",
    "browser:install": "bun --bun playwright install chromium",
    "test:properties": "bun test tests/properties",
    "verify:formal": "bun engineering/verify-formal.ts",
    "slides:build": "bun slides/build.ts",
    "slides:preview": "bun run slides:build && bun slides/serve.ts",
    "slides:preview:presenter": "bun run slides:build && bun slides/build.ts --presenter && bun slides/serve.ts --presenter",
    "slides:verify": "bun run slides:build && bun slides/build.ts --presenter && bun --bun playwright test --config slides/playwright.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "reveal.js": "6.0.2",
    "typescript": "5.9.3"
  }
}
