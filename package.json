{
  "name": "procurement-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "check:static": "bun --bun eslint src scripts engineering tests eslint.config.ts vitest.config.ts playwright.config.ts drizzle.config.ts && bun --bun tsc --noEmit",
    "verify:architecture": "bun scripts/verify-architecture.ts",
    "lab:bootstrap": "bun run lab:up && bun run lab:doctor --db-only",
    "lab:up": "docker compose up --wait --wait-timeout 60 db && bun run lab:init",
    "lab:down": "docker compose down",
    "lab:init": "bun scripts/init-lab.ts",
    "lab:reset": "bun scripts/reset-lab.ts",
    "lab:seed:ph42": "bun scripts/seed-ph42.ts",
    "lab:doctor": "bun scripts/lab-doctor.ts",
    "ph42:reproduce": "bun scripts/reproduce-ph42.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "test:unit": "bun --bun vitest run tests/unit",
    "test:integration": "bun --bun vitest run tests/integration",
    "test:concurrency": "bun --bun vitest run tests/concurrency",
    "test:security": "bun --bun vitest run tests/security",
    "test:properties": "bun --bun vitest run tests/properties",
    "test:harness": "bun --bun vitest run engineering/tests",
    "test:migration": "bun --bun vitest run tests/integration/idempotency-migration.test.ts tests/integration/approval-migration.test.ts",
    "test:e2e": "bun --bun playwright test",
    "verify:concurrency": "bun scripts/verify-concurrency.ts",
    "verify:formal": "bun engineering/verify-formal.ts",
    "verify:all": "bun engineering/verify-lab.ts",
    "loop:run": "bun engineering/loop-runner.ts run",
    "loop:status": "bun engineering/loop-runner.ts status",
    "browser:install": "bun --bun playwright install chromium",
    "slides:build": "bun slides/build.ts",
    "slides:preview": "bun run slides:build && bun slides/serve.ts",
    "slides:preview:presenter": "bun run slides:build && bun slides/build.ts --presenter && bun slides/serve.ts --presenter",
    "slides:verify": "bun run slides:build && bun slides/build.ts --presenter && bun --bun playwright test --config slides/playwright.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "reveal.js": "6.0.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
