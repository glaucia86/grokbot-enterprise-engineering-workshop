{
  "PREP": [
    {
      "id": "skills-integrity",
      "argv": ["{bun}", "engineering/bootstrap-skills.ts", "--verify"],
      "timeoutSeconds": 30
    },
    {
      "id": "specification-links",
      "argv": ["{bun}", "engineering/verify-specifications.ts"],
      "timeoutSeconds": 15
    },
    {
      "id": "engineering-test",
      "argv": ["{bun}", "--bun", "vitest", "run", "engineering/tests"],
      "timeoutSeconds": 40
    }
  ],
  "starter": [
    {
      "id": "static",
      "criteria": ["AC-10"],
      "argv": ["{bun}", "--bun", "node_modules/eslint/bin/eslint.js", "."],
      "timeoutSeconds": 45
    },
    {
      "id": "typecheck",
      "criteria": ["AC-10"],
      "argv": ["{bun}", "--bun", "node_modules/typescript/bin/tsc", "--noEmit"],
      "timeoutSeconds": 45
    },
    {
      "id": "architecture",
      "criteria": ["AC-10"],
      "argv": ["{bun}", "scripts/verify-architecture.ts"],
      "timeoutSeconds": 45
    },
    {
      "id": "unit",
      "criteria": ["AC-08", "AC-10"],
      "argv": ["{bun}", "--bun", "vitest", "run", "tests/unit"],
      "timeoutSeconds": 45
    },
    {
      "id": "properties",
      "criteria": ["AC-08"],
      "argv": ["{bun}", "--bun", "vitest", "run", "tests/properties"],
      "timeoutSeconds": 45
    },
    {
      "id": "harness-contract",
      "criteria": ["AC-12"],
      "argv": ["{bun}", "--bun", "vitest", "run", "engineering/tests"],
      "timeoutSeconds": 45
    },
    {
      "id": "http-smoke",
      "criteria": ["AC-12"],
      "argv": ["{bun}", "--bun", "vitest", "run", "tests/smoke/health.test.ts"],
      "timeoutSeconds": 25
    },
    {
      "id": "http-postgres-baseline",
      "criteria": ["AC-08"],
      "argv": ["{bun}", "--bun", "vitest", "run", "tests/integration/procurement.test.ts"],
      "timeoutSeconds": 90
    },
    {
      "id": "submission-concurrency",
      "criteria": ["AC-08"],
      "argv": ["{bun}", "scripts/verify-concurrency.ts"],
      "timeoutSeconds": 30
    },
    {
      "id": "browser",
      "criteria": ["AC-09"],
      "argv": ["{bun}", "--bun", "node_modules/@playwright/test/cli.js", "test"],
      "timeoutSeconds": 90
    }
  ],
  "solution": {
    "base": "starter",
    "checks": [
      {
        "id": "approval-concurrency",
        "criteria": ["AC-01", "AC-02", "AC-04"],
        "argv": ["{bun}", "--bun", "vitest", "run", "tests/concurrency"],
        "timeoutSeconds": 90
      },
      {
        "id": "security-regressions",
        "criteria": ["AC-03", "AC-05", "AC-06"],
        "argv": ["{bun}", "--bun", "vitest", "run", "tests/security"],
        "timeoutSeconds": 90
      },
      {
        "id": "migrations",
        "criteria": ["AC-07", "AC-08"],
        "argv": ["{bun}", "--bun", "vitest", "run", "tests/integration/idempotency-migration.test.ts", "tests/integration/approval-migration.test.ts"],
        "timeoutSeconds": 60
      },
      {
        "id": "ph42-live-approval",
        "criteria": ["AC-01", "AC-02"],
        "argv": ["{bun}", "scripts/reproduce-ph42.ts", "--isolated"],
        "timeoutSeconds": 35
      }
    ]
  },
  "VS-04": {
    "base": "starter",
    "checks": []
  },
  "VS-05": {
    "base": "solution",
    "checks": []
  }
}
